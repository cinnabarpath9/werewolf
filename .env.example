# ── 狼人杀 · 模型档案模板 ─────────────────────────────────────────────
# 用法：复制成 .env，填上 key。
#   也可以在网页「设置 → 模型 API」里填 —— 页面会写进 settings.local.json，
#   不需要重启，也不用手动改这个文件。
#
# 一组三行 = 一个「档案」，config.yaml 里用 profile: <名字> 引用（大小写都认）。
# 只接一家时：填下面任意一组，然后到「设置 → 座位分配」把 1~12 号全选它。
#
# ⚠️ 这个文件会进 Git；填好的 .env 不会（.gitignore 挡着）。不要把 key 写在这里。

# 通义千问（阿里云百炼，OpenAI 兼容模式）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-flash

# 智谱 GLM
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash

# DeepSeek 官方
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash

# 火山方舟（豆包）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=Doubao-Seed-2.1-lite

# Claude Haiku：Anthropic 不是 OpenAI 兼容接口，这里需要一个兼容中转。
# 不用它就不用填；把座位分配全指到别的 API 即可。
HAIKU_BASE_URL=https://your-relay.example.com/v1
HAIKU_API_KEY=
HAIKU_MODEL=claude-haiku-5-5

# 小米 MiMo
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-flash

# ── 语音（可选，不配就是纯文字）─────────────────────────────────────
# TTS：阿里云百炼语音合成；ASR：同一个 key 的语音识别。
VOICE_BASE_URL=https://dashscope.aliyuncs.com
VOICE_API_KEY=
TTS_MODEL=qwen-audio-3.1-tts-flash
ASR_MODEL=qwen-audio-3.1-asr-flash

# 兜底（可选）：某个座位既没写 profile 也没配档案时用它
# WOLF_BASE_URL=
# WOLF_API_KEY=
# WOLF_MODEL=

# ── 可选：手机端提示条里的 https 地址 ────────────────────────────
# 只影响提示条（麦克风/PWA 要用 https 打开），不影响能不能玩。留空就不显示。
# WOLF_PUBLIC_HTTPS_BASE=https://your-host.your-tailnet.ts.net:8443
